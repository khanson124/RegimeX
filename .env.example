# ─────────────────────────────────────────────────────────────
# RegimeX environment configuration
# Copy to `.env` and replace every CHANGE_ME value before running.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# PostgreSQL (Docker Compose default shown)
DATABASE_URL=postgresql://regimex:regimex@localhost:5432/regimex

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars_xxxxxxxx
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars_xxxxxxx
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Credential encryption — 32-byte key (hex or base64)
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_for_aes256_gcm_xxxxxxxxxxxxxxxx

# Deriv API — register a Native (PAT) app at developers.deriv.com
DERIV_APP_ID=3480EH7xcjeMLwUvdv0GP
DERIV_REST_URL=https://api.derivws.com
DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public

# CORS — comma-separated origins, or * for development
CORS_ORIGINS=*
MOBILE_APP_URL=regimex://

# Logging
LOG_LEVEL=info

# Feature flags
FEATURE_ENSEMBLE_VOTING=false
DEMO_TRADING_ENABLED=false

# ── Execution (priority) ─────────────────────────────────────
# Historical backtest → Deriv MT5 DEMO forward → validated broker-demo evidence
# → future real MT5 (unimplemented).
#
# Recommended Oracle / DEMO testing:
EXECUTION_MODE=broker_demo_mt5
REAL_MONEY_ENABLED=false
# paper_cfd remains supported as local development, unit tests, and
# broker-unavailable fallback. It is not required before MT5 DEMO.
# EXECUTION_MODE=paper_cfd
LEGACY_BINARY_ENABLED=false
# ── Deriv cTrader Open API (broker_demo_cfd) ─────────────────
# Official JSON endpoint: wss://demo.ctraderapi.com:5036
# Docs: https://help.ctrader.com/open-api/proxies-endpoints/
# CTRADER_ENVIRONMENT=demo
# CTRADER_CLIENT_ID=
# CTRADER_CLIENT_SECRET=
# CTRADER_ACCOUNT_ID=
# CTRADER_ACCESS_TOKEN=
# BROKER_DEMO_MAX_VOLUME=0.1
# BROKER_DEMO_MAX_RISK_PERCENT=0.5
# BROKER_DEMO_TEST_MODE=false
# BROKER_DEMO_ENGINE_ENABLED=false
# Do NOT enable broker_real_cfd / REAL_MONEY / BROKER_REAL_* in example env.

# ── Deriv MT5 DEMO (primary forward execution) ───────────────
# Worker/API (Docker) MUST use Compose DNS, not 127.0.0.1:
MT5_BRIDGE_URL=http://mt5-bridge:8765
# MT5_BRIDGE_SECRET=generate_with_openssl_rand_hex_32
MT5_EXPECTED_BROKER=Deriv
MT5_EXPECTED_ENVIRONMENT=demo
MT5_ENGINE_ENABLED=false
MT5_TEST_MODE=true
MT5_MAX_TEST_VOLUME=0.01
MT5_MAX_TEST_RISK_PERCENT=0.1
MT5_MAGIC_NUMBER=26082301
# Host path to MT5 MQL5/Files/regimex mailbox (Wine prefix). Never a public bind.
# MT5_MAILBOX_HOST_PATH=/home/ubuntu/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Files/regimex
# Do NOT put MT5 account passwords in this file.
# Do NOT enable broker_real_mt5. REAL_MT5_EXECUTION_NOT_IMPLEMENTED always.
PAPER_INITIAL_BALANCE=10000
PAPER_SPREAD_BPS=10
PAPER_SLIPPAGE_BPS=5
# Max quote age for paper CFD open/close/liquidation (ms). Stale → fail closed / defer.
MAX_EXECUTION_QUOTE_AGE_MS=30000
# Live strategy selection: bootstrap (regime fit) | validated (research + forward paper)
# Keep bootstrap until multi-window CFD research evidence exists.
# Do not merge historical OOS, paper forward, and MT5 broker-demo forward into one metric.
STRATEGY_SELECTION_MODE=bootstrap
OPTIMIZER_MAX_COMBINATIONS=200
ENGINE_VERSION=0.1.0

# Docker only — set false in production after first seed
SEED_ON_START=true
# Local dev: true for mock backtest candles. Production (Render): false
SEED_MOCK_CANDLES=true
# Local dev: true creates dev@regimex.local. Production: false — register in app
SEED_DEV_USER=true
# Set true ONLY for local Milestone 1 pilot (R_10 paper metadata — NOT Deriv-verified)
SEED_PILOT_INSTRUMENT_METADATA=false

# ── Mobile (Expo) ────────────────────────────────────────────
# Use your Mac's Wi-Fi IP (usually 192.168.x.x), NOT localhost or VPN/Docker IPs.
# Find it: System Settings → Wi-Fi → Details, or run: ipconfig getifaddr en0
# Expo reads these from apps/mobile/.env (symlinked to repo root .env).
# Restart Expo with cache clear after changing: pnpm dev:mobile -- -c
# Force Expo Metro to use this IP in the QR code (must match ipconfig getifaddr en0).
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.100
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000
EXPO_PUBLIC_WS_URL=ws://192.168.1.100:4000
EXPO_PUBLIC_EAS_PROJECT_ID=
